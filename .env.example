# Copy to .env on the server (mode 600). Never commit .env.
SITE_URL=https://rafilab.com
# From the Cloudflare dashboard: Zero Trust, Networks, Tunnels
TUNNEL_TOKEN=
# openssl rand -hex 24, each
POSTGRES_PASSWORD=
TIKETA_API_KEY=
SESSION_SECRET=
# A DeepSeek key used by this host only, so it can be revoked alone. Its prepaid balance is the hard spending cap.
DEEPSEEK_API_KEY=
# Hosted decision and embedding keys used by Dispatch and Lens on this host (daily request caps apply).
JEV_API_KEY=
GEMINI_API_KEY=
# openssl rand -hex 24
TYPESENSE_API_KEY=
